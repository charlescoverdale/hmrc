    family-names: Coverdale
    email: charles.f.coverdale@gmail.com
    city: London
    country: GB
keywords:
  - HMRC
  - UK tax
  - public finance
  - fiscal data
  - reproducible research
  - econometrics
license: MIT
repository-code: "https://github.com/charlescoverdale/hmrc"
